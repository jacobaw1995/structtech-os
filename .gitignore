# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# claude code local settings (personal, not team-shared)
.claude/settings.local.json

# claude code worktrees — local scratch checkouts, never committed
.claude/worktrees/

# database backups — schema + data dumps, never committed
/backups/*

# EXCEPTION — the A1.0 pre-baseline LEDGER ARCHIVE is tracked deliberately.
# `supabase_migrations.schema_migrations.statements` holds the full executed SQL
# of every migration, and for ~70 of them it is the ONLY surviving copy of their
# source (§4.7.2/§4.7.3). A1.0 rewrites that table. This is our own source code,
# not a data dump, and it contains no user data.
# The pg_dump outputs in the same directory stay ignored — they regenerate in
# seconds from the live database; ledger_statements/ does not, once A1.0 has run.
!/backups/a1_0_pre_baseline_20260823/
/backups/a1_0_pre_baseline_20260823/*
!/backups/a1_0_pre_baseline_20260823/ledger_statements/
!/backups/a1_0_pre_baseline_20260823/ledger_statements_index.tsv
!/backups/a1_0_pre_baseline_20260823/MANIFEST.md

# supabase CLI local cache
/supabase/.temp/

# BMR migration export — raw PII dump from the old app, never committed
/docs/migration/bmr-export/

# typescript
*.tsbuildinfo
next-env.d.ts
